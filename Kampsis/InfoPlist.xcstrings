{
  "sourceLanguage" : "en",
  "strings" : {
    "NSScreenCaptureUsageDescription" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Kampsis uses the image of the built-in display to fold it along with the lid. Frames stay in this Mac’s memory and are never saved."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kampsis берёт изображение встроенного экрана, чтобы складывать его вместе с крышкой. Кадры остаются в памяти этого Mac и никуда не записываются."
          }
        }
      }
    },
    "NSAppleEventsUsageDescription" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kampsis controls Terminal only when you choose to hide the system capture indicator. It opens a separate launch window and closes it afterwards."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kampsis управляет Terminal, только если вы выбрали скрытие системного индикатора захвата. Приложение открывает отдельное окно запуска и затем закрывает его."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
