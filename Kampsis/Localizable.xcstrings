    },
    "Single Snapshot" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одиночный снимок"
          }
        }
      }
    },
    "Single Snapshot uses the normal app launch and doesn’t need Terminal permissions. macOS controls its own capture indicator." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одиночный снимок использует обычный запуск приложения и не требует разрешений для Terminal. Системным индикатором захвата управляет macOS."
          }
        }
      }
    },
    "Takes one picture when the fold begins. No continuous capture; the first picture may take longer." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делает один снимок в начале сгиба без постоянного потока захвата. Подготовка первого кадра может занять больше времени."
          }
        }
      }
    },
    "Terminal didn’t finish the launch in time. Check the permission dialog and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
